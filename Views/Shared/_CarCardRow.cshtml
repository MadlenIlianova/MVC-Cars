@model WebApplication2.Models.Car
<div class="col">
    <div class="card shadow-sm h-100">
        <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Make @Model.Model">
        <div class="card-body">
            <h5 class="card-title">@Model.Make @Model.Model</h5>
            <p class="card-text mb-0"><strong>Year:</strong> @Model.Year</p>
            <p class="card-text mb-0"><strong>Class:</strong> @Model.Class</p>
            <p class="card-text mb-0"><strong>Transmission:</strong> @Model.Transmission</p>
            <p class="card-text mb-0"><strong>Drive:</strong> @Model.Drive</p>
            <p class="card-text mb-0"><strong>Fuel:</strong> @Model.Fuel_Type</p>


            <button class="btn view-more-btn open-modal-btn mt-3"
                    data-make="@Model.Make"
                    data-model="@Model.Model"
                    data-year="@Model.Year"
                    data-img="@Model.ImageUrl"
                    data-engine="@Model.Fuel_Type"
                    data-transmission="@Model.Transmission"
                    data-drive="@Model.Drive">
                View More
            </button>
        </div>
    </div>
</div>