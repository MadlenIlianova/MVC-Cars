@model IEnumerable<WebApplication2.Models.Car>

@{
    ViewData["Title"] = "Top 10 Cars (2000)";
}

<link rel="stylesheet" href="~/css/cars.css" />

<div class="container">
    <h2 class="title">@ViewData["Title"]</h2>

    <div class="car-grid">
        @foreach (var car in Model)
        {
         
            <div class="car-card" 
                 data-make="@car.Make" 
                 data-model="@car.Model"
                 data-year="@car.Year"
                 data-class="@car.Class"
                 data-transmission="@car.Transmission"
                 data-drive="@car.Drive"
                 data-fuel="@car.Fuel_Type">
                
                <img src="@car.ImageUrl" alt="@car.Make @car.Model" class="car-img" />
                <div class="car-info">
                <h3>@car.Make @car.Model</h3>

                    <button class="btn btn-sm view-more-btn">
                        View More
                    </button>
                </div>
            </div>
        }
    </div>
</div>


<div class="modal fade" id="carModal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modalTitle"></h5>
      </div>
      <div class="modal-body" id="modalBody">
    
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
}


