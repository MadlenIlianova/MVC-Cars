@model IEnumerable<WebApplication2.Models.Car>

@{
    ViewData["Title"] = "Top 10 Cars (2000)";
}

<div class="container">
    <h2 class="title">@ViewData["Title"]</h2>

    <div class="car-grid">
        @foreach (var car in Model)
        {
         
            <div class="car-card" 
                 data-make="@car.Make" 
                 data-model="@car.Model"
                 data-year="@car.Year"
                 data-class="@car.Class"
                 data-transmission="@car.Transmission"
                 data-drive="@car.Drive"
                 data-fuel="@car.Fuel_Type">
                
                <img src="@car.ImageUrl" alt="@car.Make @car.Model" class="car-img" />
                <div class="car-info">
                <h3>@car.Make @car.Model</h3>
                                                                                                                                                                     
                    <button class="btn btn-primary btn-sm view-more-btn">
                        View More
                    </button>
                </div>
            </div>
        }
    </div>
</div>


<div class="modal fade" id="carModal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="modalTitle"></h5>
      </div>
      <div class="modal-body" id="modalBody">
    
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Затвори</button>
      </div>
    </div>
  </div>
</div>



<style>

    /* === Основен контейнер === */
    .container {
        max-width: 1500px;
        margin: 0 auto;
        padding: 40px 20px;
        text-align: center;
    }

    .title {
        margin-bottom: 40px;
        font-size: 2rem;
        font-weight: 600;
        color: #222;
    }

    /* === Грид с 5 колони === */
    .car-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr); 
        gap: 25px;
        justify-items: center;
    }

    /* === Стил за картите === */
    .car-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 2px 8px rgba(0, 0, 255, 0.25);
        transition: all 0.3s ease;
        overflow: hidden;
        text-align: left;
        width: 100%;
        max-width: none; 
        cursor: pointer;
        opacity: 0;
        transform: translateY(15px) scale(0.98);
        animation: fadeInUp 0.6s forwards;
    }

        /* === Hover ефект === */
        .car-card:hover {
            transform: translateY(-6px) scale(1.02);
            box-shadow: 0 8px 16px rgba(0, 0, 255, 0.25);
        }

    /* === Картинки === */
    .car-img {
        width: 100%;
        height: 140px;
        object-fit: cover;
        background-color: #f3f3f3;
    }

    /* === Текстова част === */
    .car-info {
        padding: 12px 16px;
        font-size: 0.9rem;
    }

        .car-info h3 {
            font-size: 1rem;
            margin-bottom: 8px;
            color: #333;
            text-transform: capitalize;
        }

        .car-info p {
            margin: 2px 0;
            color: #555;
        }
    

    .view-more-btn {
        background-color: #007bff; 
        color: white;
        border: none;
        padding: 8px 12px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        margin-top: 10px;
        width: 100%;
        text-align: center;
        transition: background-color 0.2s ease;
    }

    .view-more-btn:hover {
        background-color: #0056b3; 
    }




    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(15px) scale(0.98);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .car-card:nth-child(1) { animation-delay: 0.1s; }
    .car-card:nth-child(2) { animation-delay: 0.2s; }
    .car-card:nth-child(3) { animation-delay: 0.3s; }
    .car-card:nth-child(4) { animation-delay: 0.4s; }
    .car-card:nth-child(5) { animation-delay: 0.5s; }
    .car-card:nth-child(6) { animation-delay: 0.6s; }
    .car-card:nth-child(7) { animation-delay: 0.7s; }
    .car-card:nth-child(8) { animation-delay: 0.8s; }
    .car-card:nth-child(9) { animation-delay: 0.9s; }
    .car-card:nth-child(10) { animation-delay: 1.0s; }
</style>


@section Scripts {
    <script>
        $(document).ready(function () {
            
            $('.view-more-btn').on('click', function (e) {
                
   
                var card = $(this).closest('.car-card');
                
            
                var make = card.data('make');
                var model = card.data('model');
                var year = card.data('year');
                var carClass = card.data('class');
                var transmission = card.data('transmission');
                var drive = card.data('drive');
                var fuel = card.data('fuel');

              
                $('#modalTitle').text(make + ' ' + model); 
                
                var modalContent = `
                    <p><strong>Year:</strong> ${year}</p>
                    <p><strong>Class:</strong> ${carClass}</p>
                    <p><strong>Transmission:</strong> ${transmission}</p>
                    <p><strong>Drive:</strong> ${drive}</p>
                    <p><strong>Fuel:</strong> ${fuel}</p>
                `;
                $('#modalBody').html(modalContent);

                var carModal = new bootstrap.Modal(document.getElementById('carModal'));
                carModal.show();
            });
        });
    </script>
}﻿



